{
  "name": "focuswithakram",
  "private": true,
  "scripts": {
    "angular": "npm --prefix frontend-angular start -- --host 127.0.0.1",
    "react": "npm --prefix frontend-react start",
    "build:angular": "npm --prefix frontend-angular run build",
    "build:react": "npm --prefix frontend-react run build",
    "test:angular": "npm --prefix frontend-angular test -- --watch=false",
    "test:react": "npm --prefix frontend-react test",
    "test:e2e": "npm --prefix frontend-react run test:e2e --",
    "lint:angular": "node frontend-react/node_modules/eslint/bin/eslint.js --config frontend-angular/eslint.config.mjs frontend-angular/src",
    "lint:react": "npm --prefix frontend-react run lint",
    "test:volume": "node frontend-react/e2e/volume.mjs"
  }
}
